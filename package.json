{
  "name": "appellate-prac",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:convex": "convex dev",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "build:vercel": "DEPLOY_TARGET=vercel bun run build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare bun run build",
    "convex:deploy": "convex deploy",
    "deploy:backend": "bun run release:check --production --target=backend && bun run convex:deploy",
    "release:check": "bun scripts/release-gate.ts",
    "release:source-refresh": "bun scripts/source-refresh.ts",
    "release:vercel": "bun run release:check --production --target=web && bun run typecheck && bun run test && DEPLOY_TARGET=vercel vite build",
    "release:cloudflare": "bun run release:check --production --target=web && bun run typecheck && bun run test && DEPLOY_TARGET=cloudflare vite build && wrangler deploy",
    "preview": "vite preview",
    "preview:cloudflare": "DEPLOY_TARGET=cloudflare vite dev --port 3000",
    "test": "vitest run",
    "test:cloudflare-preview": "bun scripts/cloudflare-preview-smoke.ts",
    "prepare": "husky",
    "lint": "bun run --bun lint-staged",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'convex/**/*.ts'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "sh -c 'bun run typecheck'"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-router": "1.170.7",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.0",
    "@tanstack/react-start": "1.168.10",
    "@tanstack/router-plugin": "1.168.10",
    "convex": "^1.42.1",
    "lucide-react": "^0.545.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "0.0.54",
    "husky": "^9.0.0",
    "jsdom": "^28.1.0",
    "lint-staged": "17.6.0",
    "prettier": "^3.0.0",
    "nitro": "^3.0.260903-beta",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5",
    "wrangler": "^4.94.0"
  }
}
